{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/sw.js",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate",
        "Service-Worker-Allowed": "/"
      },
      "dest": "/dist/sw.js"
    },
    {
      "src": "/manifest.webmanifest",
      "headers": {
        "Content-Type": "application/manifest+json"
      },
      "dest": "/dist/manifest.webmanifest"
    },
    {
      "src": "/manifest.json",
      "headers": {
        "Content-Type": "application/json"
      },
      "dest": "/dist/manifest.json"
    },
    {
      "src": "/registerSW.js",
      "dest": "/dist/registerSW.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/dist/assets/$1"
    },
    {
      "src": "/llms.txt",
      "dest": "/dist/llms.txt"
    },
    {
      "src": "/baidu_sitemap.xml",
      "dest": "/dist/baidu_sitemap.xml"
    },
    {
      "src": "/indexnow-(.*).txt",
      "dest": "/dist/indexnow-$1.txt"
    },
    {
      "src": "/baidu_verify_(.*).html",
      "dest": "/dist/baidu_verify_$1.html"
    },
    {
      "src": "/robots.txt",
      "dest": "/dist/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/dist/sitemap.xml"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}